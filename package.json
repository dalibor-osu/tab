{
  "name": "tab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun tools/build.mjs",
    "build:ext": "bun tools/build.mjs ext",
    "icons": "bun tools/make-icons.mjs",
    "lint": "eslint . --config tools/eslint.config.js",
    "lint:fix": "eslint . --config tools/eslint.config.js --fix",
    "format": "prettier --write . --config tools/.prettierrc --ignore-path tools/.prettierignore --ignore-path .gitignore",
    "format:check": "prettier --check . --config tools/.prettierrc --ignore-path tools/.prettierignore --ignore-path .gitignore",
    "check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.3.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.4.2",
    "typescript": "5",
    "typescript-eslint": "^8.70.0"
  }
}
